# birdcount configuration — copy to `.env` and fill in.
#
# This file is the catalogue of every key the project reads: a key set in
# `.env` but missing here triggers a startup warning (usually a typo).
# Relative paths are resolved against the project root, not the directory you
# launch from. Process environment variables override `.env`.

# --- Core (every app) -----------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs
# Datasets, videos and region masks live outside the repo.
DATA_ROOT=../data
# Everything a run writes (reports, count logs, alarm evidence) goes under here.
OUTPUT_ROOT=outputs
# Checkpoint every app runs inference with (.pth or a training .tar; EMA
# weights are used when the file has them).
MODEL_PATH=../ckpts/best.pth
# Model input geometry; frames are resized to it. The pile-up thresholds were
# calibrated at 1280x720 — change only to experiment. Multiples of 8.
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
# Per-camera region masks: one PNG per camera named by its bare MAC
# (B8A44FD51C3C.png), white = count, black = ignore. Blank disables masking,
# which over-counts against thresholds calibrated on masked input.
MASK_DIR=../data/images/masks
