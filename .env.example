# birdcount configuration — copy to `.env` and fill in.
#
# This file is the catalogue of every key the project reads: a key set in
# `.env` but missing here triggers a startup warning (usually a typo).
# Relative paths are resolved against the project root, not the directory you
# launch from. Process environment variables override `.env`.

# --- Core (every app) -----------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs
# Datasets, videos and region masks live outside the repo.
DATA_ROOT=../data
# Everything a run writes (reports, count logs, alarm evidence) goes under here.
OUTPUT_ROOT=outputs
# Checkpoint every app runs inference with (.pth or a training .tar; EMA
# weights are used when the file has them).
MODEL_PATH=../ckpts/best.pth
# Model input geometry; frames are resized to it. The pile-up thresholds were
# calibrated at 1280x720 — change only to experiment. Multiples of 8.
IMAGE_WIDTH=1280
IMAGE_HEIGHT=720
# Per-camera region masks: one PNG per camera named by its bare MAC
# (B8A44FD51C3C.png), white = count, black = ignore. Blank disables masking,
# which over-counts against thresholds calibrated on masked input.
MASK_DIR=../data/images/masks

# --- Deploy (live runtime) ---------------------------------------------------------

# Debug GUI panel; with SMS in dry-run its manual trigger simulates a whole alarm.
DEBUG=0

# Zones: cameras (IP + MAC), speakers, smart plugs.
TOPOLOGY_PATH=configs/topology.yaml
# camera = the topology's cameras, live. video = the clips in VIDEO_PATHS
# replayed as cameras (zone found by the MAC in each filename).
SOURCE_TYPE=camera
# Comma-separated video files and/or folders.
VIDEO_PATHS=../data/videos
# Only the first N streams; blank = all.
NUM_STREAMS=
# {ip} is filled in per camera; credentials are added from the two keys below.
CAMERA_URL=https://{ip}/mjpg/1/video.mjpg
CAMERA_USERNAME=root
CAMERA_PASSWORD=root

# Inference rate per camera; cameras are decoded at their own rate regardless.
FPS=10
# Frame slots per camera in the shared-memory ring (>= 3).
NUM_BUFFERS=4
# Inference processes; camera i goes to worker i % NUM_WORKERS_PER_GPU.
NUM_WORKERS_PER_GPU=1
CUDA_DEVICE=0
# Decode on the GPU video engine, falling back to software per stream.
HW_DECODE=1

# --- Deploy: alarm and actions -------------------------------------------------------

ALARM_CONFIG_PATH=configs/alarm.json
# Evidence + dry-run SMS output; blank = the output_dir inside the alarm config.
ALARM_OUTPUT_DIR=
ENABLE_SMS_ALARM=0
# 0 = dry-run (payloads written to disk, nothing sent). 1 + key = real SMS.
SMS_ALARM_REAL_WORKER=0
FARM_SMS_API_KEY=

ENABLE_SPEAKER=0
SPEAKER_USERNAME=admin
SPEAKER_PASSWORD=admin
SPEAKER_AUDIO_FILE=7MB.wav

ENABLE_SMART_PLUG=0
TAPO_EMAIL=
TAPO_PASSWORD=

# --- Deploy: monitor ------------------------------------------------------------------

# Camera grid window at start; also switchable from the operator panel.
ENABLE_MONITOR=0
# Grid refresh rate; cameras are retrieved at this rate while the monitor is open.
MONITOR_FPS=10
# Overlays at start (heatmap / region mask); switchable from the debug panel.
SHOW_DENSITY_MAP=0
SHOW_MASK=0

# --- Deploy: records ------------------------------------------------------------------

# Per-camera counts every second + review snapshots, inside the local-time window.
ENABLE_COUNT_LOGGER=0
COUNT_LOG_DIR=outputs/count_log
COUNT_LOG_HOURS=06:00-20:00
# Every camera into fixed-length segments at the inference rate; per camera in the debug panel.
ENABLE_VIDEO_RECORDER=0
VIDEO_RECORD_DIR=recordings
VIDEO_SEGMENT_SECONDS=300
# Falls back to mp4v when this machine cannot encode the fourcc.
VIDEO_FOURCC=mp4v
# Operator and alarm actions as JSONL; blank disables.
AUDIT_LOG_PATH=logs/audit.jsonl
# Live state for the farm backend (python -m birdcount.deploy.webui), every second; blank disables.
STATUS_PATH=outputs/live/status.json

# --- Training: labelling (Label Studio) -------------------------------------------------

LABEL_STUDIO_URL=http://localhost:8080
# Label Studio > Account & Settings > Access Token.
LABEL_STUDIO_API_KEY=
# The project the labelling commands act on; --project-id overrides.
LABEL_STUDIO_PROJECT_ID=
# Label Studio's LOCAL_FILES_DOCUMENT_ROOT; blank = DATA_ROOT. Image URLs in
# tasks are paths under it, so it must match how Label Studio was started.
LABEL_STUDIO_FILES_ROOT=

# --- Training: control panel (python -m birdcount.training.webui) -----------------------

# Where the panel's Label Studio keeps its database and uploads (--data-dir);
# blank = DATA_ROOT. The port comes from LABEL_STUDIO_URL.
LABEL_STUDIO_DATA_DIR=
# The ngrok domain of the public link (e.g. name.ngrok-free.app); blank = none.
LABEL_STUDIO_PUBLIC_URL=
